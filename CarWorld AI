AVAILABLE_TOOLS = {"calculate_emi": calculate_emi, "search_car_web": search_car_web}


def execute_tool(name, arguments):
    function = AVAILABLE_TOOLS.get(name)
    if function is None:
        return {"error": f"Unknown tool: {name}"}
    if not isinstance(arguments, dict):
        return {"error": "Tool arguments must be a JSON object."}
    try:
        result = function(**arguments)
        logger.info("Executed tool: %s", name)
        return result
    except (TypeError, ValueError, OverflowError) as exc:
        return {"error": str(exc)}
    except Exception:
        logger.exception("Tool execution failed: %s", name)
        return {"error": "The tool failed unexpectedly."}


def clean_carworld_answer(answer):
    """Remove citation/link syntax. This is presentation cleanup, not fact-checking."""
    if not answer:
        return "I couldn't generate a response. Please try again."

    # Remove common citation styles, including model-generated reference markers.
    answer = re.sub(r"【[^】]*】", "", answer)
    answer = re.sub(r"\[(?:\d+|\d+†[^\]]*)\]", "", answer)
    # Remove Markdown links while retaining visible link text.
    answer = re.sub(r"\[([^\]]+)\]\(https?://[^)]+\)", r"\1", answer)
    # Remove bare URLs.
    answer = re.sub(r"https?://\S+", "", answer)
    # Remove common inline source labels if the model adds them as list items.
    answer = re.sub(r"(?im)^\s*[-*]\s*(?:source|sources|references|citations)\s*:.*$", "", answer)
    answer = re.sub(r"[ \t]{2,}", " ", answer)
    answer = re.sub(r"\n[ \t]*\n(?:[ \t]*\n)+", "\n\n", answer)
    return answer.strip()


class CarWorldAgent:
    def __init__(self, client, model, tools, system_prompt):
        self.client = client
        self.model = model
        self.tools = tools
        self.system_prompt = system_prompt

    def run(self, messages):
        agent_messages = [{"role": "system", "content": self.system_prompt}, *messages]

        for _ in range(MAX_TOOL_ROUNDS):
            response = self.client.chat.completions.create(
                model=self.model,
                messages=agent_messages,
                tools=self.tools,
                tool_choice="auto",
                temperature=0.2,
            )
            assistant_message = response.choices[0].message
            tool_calls = assistant_message.tool_calls
            if not tool_calls:
                break

            agent_messages.append({
                "role": "assistant",
                "content": assistant_message.content,
                "tool_calls": [call.model_dump(exclude_none=True) for call in tool_calls],
            })

            for call in tool_calls:
                try:
                    arguments = json.loads(call.function.arguments or "{}")
                    if not isinstance(arguments, dict):
                        raise ValueError("Tool arguments must be a JSON object.")
                    result = execute_tool(call.function.name, arguments)
                except (json.JSONDecodeError, ValueError) as exc:
                    result = {"error": str(exc)}

                agent_messages.append({
                    "role": "tool",
                    "tool_call_id": call.id,
                    "content": json.dumps(result, ensure_ascii=False),
                })
        else:
            raise RuntimeError("Agent reached its maximum tool-call rounds.")

        # Generate the final answer without streaming so citation cleanup happens
        # before anything is shown to the user (no citations flash on screen).
        response = self.client.chat.completions.create(
            model=self.model,
            messages=agent_messages,
            temperature=0.2,
        )
        raw_answer = response.choices[0].message.content or ""
        final_answer = clean_carworld_answer(raw_answer)
        yield final_answer


def create_agent():
    return CarWorldAgent(client=client, model=MODEL, tools=TOOLS, system_prompt=SYSTEM_PROMPT)


agent = create_agent()


def respond(user_message, history):
    history = list(history or [])
    user_message = (user_message or "").strip()
    if not user_message:
        yield "", history, history
        return

    recent_history = history[-MAX_HISTORY_MESSAGES:]
    visible_history = recent_history + [{"role": "user", "content": user_message}]
    answer = ""

    try:
        for final_answer in agent.run(visible_history):
            answer = final_answer
    except Exception:
        logger.exception("CarWorld AI request failed")
        answer = "Sorry, I couldn't complete your request. Please try again."

    final_history = visible_history + [{"role": "assistant", "content": answer}]
    yield "", final_history, final_history


def clear_conversation():
    return [], []


with gr.Blocks(title="CarWorld AI") as demo:
    gr.Markdown("# CarWorld AI")
