# Copy to .env and provide local development credentials before starting Compose.
# Render production uses DATABASE_URL; leave this empty locally to use POSTGRES_*.
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=carworld
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Supabase Auth project configuration. The anon/publishable key is browser-safe.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Private server-only AI credentials. Never put these in frontend configuration.
GROQ_API_KEY=
TAVILY_API_KEY=

# Groq model (primary provider)
GROQ_MODEL=openai/gpt-oss-120b

# Groq rate limit cooldown (seconds). After Groq returns 429, wait this long
# before retrying Groq. If Retry-After header is present, it takes precedence.
GROQ_COOLDOWN_SECONDS=60

# Fine-tuned Qwen3-4B fallback provider (Hugging Face Inference Endpoint or compatible API)
# Set QWEN3_ENDPOINT_URL to enable fallback on Groq rate limit (HTTP 429)
# Example: QWEN3_ENDPOINT_URL=https://your-hf-endpoint.hf.space
QWEN3_ENDPOINT_URL=
QWEN3_MODEL_ID=qwen3-4b-finetuned
QWEN3_TIMEOUT=60.0
# Set to "true" only if the deployed Qwen3 endpoint supports OpenAI-compatible tool calling
QWEN3_SUPPORTS_TOOLS=false
# Hugging Face token for private endpoint authentication (optional)
HUGGINGFACE_TOKEN=

# Comma-separated browser origins allowed to call this backend.
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Development allows more local testing; set production when deploying.
# Defaults: development 30/minute and 300/day; production 5/minute and 40/day.
CARWORLD_ENV=development
# Optional explicit overrides:
# CHAT_RATE_LIMIT_PER_MINUTE=30
# CHAT_RATE_LIMIT_PER_DAY=300
